# Environment variables for CV Ingestion App
# Copy to .env and fill in your values

# Server
PORT=3737
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# File upload limits
MAX_FILE_SIZE_MB=10

# Profile sync — writes confirmed profile here
PROFILE_OUTPUT_PATH=../profile.json

# GitHub OAuth & Publishing
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3737/api/auth/github/callback
GITHUB_REPO_OWNER=tafabande
GITHUB_REPO_NAME=portfolio
GITHUB_PERSONAL_TOKEN=

